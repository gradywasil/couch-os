    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@couch-emu/shared": "*",
    "express": "^5.1.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "tsx": "^4.19.3"
  }
}
